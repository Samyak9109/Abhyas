# ==============================================================================
# Abhyas Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - User interview sessions are local-first. User AI keys are supplied by the user
#   in the browser and stored locally in IndexedDB (WebCrypto encrypted).
# - Zero user interview prompts or resumes are ever sent through a project proxy.
# - The environment variables below configure local dev endpoints and the optional
#   Phase 5 company research backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Abhyas"

# Optional backend endpoint for company research (Phase 5). Defaults to empty or local.
VITE_API_URL="http://localhost:8000"

# Optional static CDN mirror endpoint for curated company packs
VITE_STATIC_PACKS_URL=""

# ------------------------------------------------------------------------------
# Backend Research Service (apps/api - Phase 5 FastAPI Service)
# ------------------------------------------------------------------------------
# Server Environment
ENVIRONMENT="development"
PORT=8000
CORS_ORIGINS="http://localhost:5173"

# Database (PostgreSQL for company research packs & demand tracking)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abhyas_research"

# Server-Side AI Provider (used ONLY for company research pipeline, NEVER proxies user interviews)
PROJECT_AI_PROVIDER="gemini"
PROJECT_AI_API_KEY=""

# Search Engine API (used for fetching public company information)
SEARCH_API_KEY=""

# Administrative Secret (protects internal seed pack review & job dispatch endpoints)
ADMIN_SECRET=""
e
# Cost & Budget Guardrails (Hard budget caps in cents)
DAILY_BUDGET_CENTS=500
MONTHLY_BUDGET_CENTS=10000

# Anti-Abuse Challenge (Cloudflare Turnstile secret for public request endpoints)
TURNSTILE_SECRET_KEY=""
