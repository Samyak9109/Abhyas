# ------------------------------------------------------------------------------
# Backend Research Service Environment Configuration (apps/api - Phase 5)
# ------------------------------------------------------------------------------
# This service is used ONLY for company pack research.
# It NEVER proxies user interview sessions or stores candidate data.
# ------------------------------------------------------------------------------

# Server Runtime
ENVIRONMENT="development"
PORT=8000
CORS_ORIGINS="http://localhost:5173"

# PostgreSQL Database (used for caching company research packs and tracking demand requests)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abhyas_research"

# Server-Side AI Provider for Research Pipeline (gemini | openai)
PROJECT_AI_PROVIDER="gemini"
PROJECT_AI_API_KEY=""

# Public Search Engine API Key (e.g. Google Search / Bing / Tavily)
SEARCH_API_KEY=""

# Admin Authentication Token (for manual seed reviews and manual job triggers)
ADMIN_SECRET=""

# Cost Control Limits (Hard budget caps in cents)
DAILY_BUDGET_CENTS=500
MONTHLY_BUDGET_CENTS=10000

# Cloudflare Turnstile Secret Key (anti-bot challenge for public request endpoints)
TURNSTILE_SECRET_KEY=""
