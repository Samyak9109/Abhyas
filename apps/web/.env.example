# Application branding title
VITE_APP_NAME="Abhyas"

# Optional backend URL for company research (Phase 5). Defaults to localhost or static mirror.
VITE_API_URL="http://localhost:8000"

# Optional static CDN mirror URL for pre-generated company packs
VITE_STATIC_PACKS_URL=""
