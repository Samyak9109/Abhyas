{
  "name": "Abhyas",
  "short_name": "Abhyas",
  "description": "Private, deliberate AI interview practice in your browser. Zero telemetry, self-hosted fonts, canonical rubrics.",
  "start_url": "/app/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121110",
