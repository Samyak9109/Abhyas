{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "tests/setup.ts"],
      "project": ["*.{js,mjs,ts}", "tests/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/content": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": ["src/main.tsx!", "src/components/index.ts!", "index.html!", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
