{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "tests/setup.ts", "tests/**/*.test.ts", "scripts/*.mjs"],
      "project": ["*.{js,mjs,ts}", "tests/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@abhyas/content", "@abhyas/core"]
    },
    "packages/core": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/content": {
      "entry": ["src/index.ts!", "src/validate-cli.ts!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx!",
        "src/components/index.ts!",
        "src/screens/public/prerender.tsx!",
        "src/workers/parser.worker.ts!",
        "index.html!",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
