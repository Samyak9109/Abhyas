{
  "name": "abhyas-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "validate:content": "pnpm --filter @abhyas/content run validate",
    "check:licenses": "node scripts/check-licenses.mjs",
    "knip": "knip",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "eslint": "9.21.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "knip": "5.45.0",
    "prettier": "3.5.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vitest": "3.0.7",
    "vitest-axe": "0.1.0"
  }
}
